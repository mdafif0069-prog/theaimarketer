# SolitAir Social Hub — environment variables.
# Copy to `.env.local` and fill in. NEVER put platform tokens or the Anthropic
# key in here — those live server-side only (Supabase Edge Functions / Vault).

# --- Phase 2: Supabase (frontend-safe, anon key only) ---
# VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Phase 5: AI ---
# Base URL of the deployed `ai` Edge Function. When set, the Assistant and
# "Refine caption" call the real backend; when unset, a local fallback is used.
# VITE_AI_ENDPOINT=https://YOUR-PROJECT.functions.supabase.co/ai
